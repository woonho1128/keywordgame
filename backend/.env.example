# ====================================================================
# Spring Boot 환경변수 예시
# 운영 시 실제 값을 채워서 사용 (절대 git에 커밋 X)
# ====================================================================

# --- DB (Supabase Transaction Pooler) ---
# 핵심: channelBinding=disable (SCRAM 인증 호환), prepareThreshold=0 (pooler 호환)
DB_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require&channelBinding=disable&prepareThreshold=0
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_db_password

# --- 프로필 ---
# 로컬: local (기본값) / 운영: prod
SPRING_PROFILES_ACTIVE=local

# --- 서버 포트 ---
SERVER_PORT=8080

# --- CORS 허용 origin (쉼표 구분) ---
# 로컬: http://localhost:3000
# 운영 예시: https://your-app.vercel.app,https://your-domain.com
CORS_ORIGINS=http://localhost:3000

# --- OpenAI (WordSim 임베딩 + AI 사주 공용) ---
# 비어있으면: WordSim은 사전(word_vectors.bin) 단어만 처리, AI 사주는 비활성
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# --- AI 사주 (선택사항) ---
# 해석에 쓸 Chat 모델. 사주 1건당 대략 $0.001 미만
OPENAI_CHAT_MODEL=gpt-4o-mini
# OpenAI 호환 게이트웨이를 쓸 경우에만 변경
# OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
# 진태양시 보정(분). 서울 기준 -30이 기본값, 0이면 보정 안 함
SAJU_LONGITUDE_OFFSET=-30
# AI 호출 한도 (24시간 기준). 비용 방어용
SAJU_LIMIT_PER_SESSION=10
SAJU_LIMIT_TOTAL=300
