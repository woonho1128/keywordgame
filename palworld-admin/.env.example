# ===== 팰월드 관리 패널 환경변수 =====
# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env

# 관리자 계정 (JSON 배열). role 은 super 또는 admin
#   super = 모든 기능 + 서버 유지관리 + 작업 로그 열람
#   admin = 접속자 관리/공지/저장 등 기본 기능만 (유지관리·로그 안 보임)
# 계정은 원하는 만큼 추가할 수 있고, super 도 여러 개 둘 수 있습니다.
# ⚠️ 한 줄로, 비밀번호엔 큰따옴표(") 와 백슬래시(\) 는 쓰지 마세요.
ADMINS=[{"user":"woonho","pass":"슈퍼관리자_비번_변경","role":"super"},{"user":"wonono","pass":"두번째_슈퍼_비번","role":"super"},{"user":"teru","pass":"일반관리자_비번_변경","role":"admin"}]

# (ADMINS 를 안 쓸 때만) 단일 슈퍼관리자 비번 — ADMINS 가 있으면 무시됨
# PANEL_PASSWORD=

# 세션 암호화 키 (아무 긴 랜덤 문자열. 예: openssl rand -hex 32 결과)
SESSION_SECRET=여기에_긴_랜덤_문자열

# 팰월드 RCON 접속 정보
RCON_HOST=palworld-server
RCON_PORT=25575
# RCON_PASSWORD: PalWorldSettings.ini 의 AdminPassword 와 동일하게
RCON_PASSWORD=여기에_팰월드_AdminPassword

# 작업 로그 저장 위치(컨테이너 내부 경로 — 보통 그대로 두세요. ./data 로 영구저장됨)
LOG_FILE=/data/actions.log

# 서버 설정 편집 기능이 읽을 팰월드 설정 폴더(호스트 경로).
# 기본값은 ~/palworld-server 에 설치한 경우입니다. 경로가 다르면 여기서 바꾸세요.
PAL_CONFIG_HOST_DIR=/home/ubuntu/palworld-server/palworld/Pal/Saved/Config/LinuxServer

# Cloudflare 명명 터널 토큰 (eyJ... 로 시작하는 긴 문자열)
TUNNEL_TOKEN=
